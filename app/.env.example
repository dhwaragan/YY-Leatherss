# ============================================
# YY LEATHERS - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# See NEW_SUPABASE_SETUP.md for full setup guide
# ============================================

# ---- SUPABASE (REQUIRED) ----
# Get from: https://app.supabase.com/project/_/settings/api
# Create a NEW Supabase project (old one hit quota limit)

# Your new Supabase project URL
VITE_SUPABASE_URL="https://YOUR_NEW_PROJECT.supabase.co"

# Your new Supabase anon/public key (safe for frontend)
VITE_SUPABASE_ANON_KEY="your_new_supabase_anon_key_here"

# Server-side Supabase URL (same as above, used by server.ts)
SUPABASE_URL="https://YOUR_NEW_PROJECT.supabase.co"

# Server-side Supabase anon key (same as above)
SUPABASE_ANON_KEY="your_new_supabase_anon_key_here"

# ---- RAZORPAY (REQUIRED for payments) ----
# Get from: https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID="rzp_live_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# ---- ADMIN SECURITY ----
# Set a strong admin password (min 12 chars recommended)
VITE_ADMIN_PASSWORD="YourStrongAdminPassword2026!"

# Admin email (the only email allowed to access admin panel)
ADMIN_EMAIL="dhwaragandhwaragan9@gmail.com"

# ---- JWT SECRET ----
# Used for session tokens (use a long random string)
JWT_SECRET="your_long_random_jwt_secret_string_here"

# ---- APP URL ----
# The URL where this app is hosted
APP_URL="http://localhost:3000"

# ---- ALLOWED ORIGINS (CORS) ----
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,https://yyleathers.com,https://www.yyleathers.com"

# ---- GEMINI AI (OPTIONAL) ----
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"